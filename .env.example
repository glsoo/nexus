# Copy to .env. Never commit .env.

# Login. Fill in both with: npm run set-password -- <user> <password>
NEXUS_USER=
NEXUS_PASS_HASH=

# API keys. Set at least one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. These are the defaults. Write full paths, because ~ is not expanded here.
#NEXUS_PORT=7711
#NEXUS_PROJECTS=/home/you/projects
#NEXUS_HOME=/home/you/.nexus
#NEXUS_MODEL=gpt-6.1-sol
#NEXUS_AUTO_UPDATE=1

# Optional. Public address used in present links, for example https://nexus.example.com
#NEXUS_URL=

# Optional. Name of another tool whose .name/ folders and NAME.md should also be read.
#NEXUS_COMPAT=
